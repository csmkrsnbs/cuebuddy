PORT=3001
NODE_ENV=production

OLLAMA_BASE_URL=https://YOUR-POD-11434.proxy.runpod.net
OLLAMA_ANALYSIS_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=180000
OLLAMA_KEEP_ALIVE=15m

LOCAL_STT_BASE_URL=https://YOUR-POD-8000.proxy.runpod.net
LOCAL_STT_TRANSCRIPTIONS_PATH=/v1/audio/transcriptions
LOCAL_STT_MODEL=Systran/faster-whisper-small
LOCAL_STT_TIMEOUT_MS=120000

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connect_timeout=15"

# Use the actual frontend origin in production.
ALLOWED_ORIGIN=https://cuebuddy.example.com

STORE_ANALYSIS_RESULTS=false
STORE_TEXT_PREVIEW=false
