PORT=3001
NODE_ENV=development

# Açık kaynak analiz modeli - Ollama
# Önce bilgisayarda/sunucuda Ollama çalışmalı: ollama serve
# Model örneği: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ANALYSIS_MODEL=llama3.1:8b

# Açık kaynak konuşma-yazı servisi
# OpenAI-compatible Whisper sunucusu kullanılacak.
# Örn: openedai-whisper / faster-whisper-server / whisper.cpp uyumlu server
LOCAL_STT_BASE_URL=http://localhost:8000
LOCAL_STT_TRANSCRIPTIONS_PATH=/v1/audio/transcriptions
LOCAL_STT_MODEL=whisper-small

# Neon PostgreSQL
# DATABASE_URL: Neon pooled connection string. Hostname contains -pooler.
# DIRECT_URL: Neon direct connection string. Used by Prisma CLI for migrations/db push.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# CORS
ALLOWED_ORIGIN=*

# Privacy controls for database logging
# false: store request logs + hashes/metadata only
# true: also store AI result content such as meaning/suggestedReply/detectedPhrase
STORE_ANALYSIS_RESULTS=false

# true: store transcript/text previews in Neon. Keep false unless you have explicit user consent.
STORE_TEXT_PREVIEW=false
