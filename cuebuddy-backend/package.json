{
  "name": "cuebuddy-backend",
  "version": "1.0.0",
  "description": "CueBuddy production backend with Ollama, Speaches and Neon PostgreSQL",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "multer": "latest",
    "nanoid": "latest",
    "@prisma/client": "latest",
    "@prisma/adapter-neon": "latest",
    "tsx": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "typescript": "latest",
    "prisma": "latest"
  }
}
