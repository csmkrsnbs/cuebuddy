{
  "name": "cuebuddy-backend",
  "version": "0.1.0-open-source-ai",
  "description": "CueBuddy v0.1 backend with Ollama/local Whisper analysis and Neon PostgreSQL persistence",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-neon": "latest",
    "@prisma/client": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "multer": "latest",
    "nanoid": "latest",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "prisma": "latest",
    "typescript": "latest"
  }
}
