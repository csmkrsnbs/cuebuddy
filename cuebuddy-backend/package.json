{
  "name": "cuebuddy-backend",
  "version": "2.0.0",
  "description": "CueBuddy production backend with Ollama, Speaches and Neon PostgreSQL",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.0",
    "multer": "2.2.0",
    "nanoid": "6.0.0",
    "@prisma/client": "7.8.0",
    "@prisma/adapter-neon": "7.8.0",
    "tsx": "4.23.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "26.1.1",
    "typescript": "7.0.2",
    "prisma": "7.8.0"
  }
}
